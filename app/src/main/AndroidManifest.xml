<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The microphone, and the foreground service that keeps it open with the app in the background.

      FOREGROUND_SERVICE_TYPE_MICROPHONE is not optional and its absence does not look like a
      permissions problem. Without the type declared, Android 14 stops the capture the moment the
      app leaves the screen, and the symptom is a slot that fills with nothing at all — which is
      exactly the failure this app is most likely to hit, because recording from the background is
      the workflow it exists for.
    -->
    <!-- Transcription and the two voice engines. Nothing else in the app reaches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.SamplePlayer">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          EVERYTHING OVERLAID GOES THROUGH THIS ONE SERVICE.

          TYPE_ACCESSIBILITY_OVERLAY rather than TYPE_APPLICATION_OVERLAY, so one permission covers
          the hairline, the triangle and the status line together — and because draw-over-apps
          cannot draw over the notification shade, measured in MANTRA_ROUTE.
        -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
