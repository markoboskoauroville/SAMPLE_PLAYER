<?xml version="1.0" encoding="utf-8"?>
<!--
  THE MONOCHROME VARIANT: the same square and the same eleven bars, in one colour.

  It must be the SAME SHAPE as the colour version. A themed icon that differs from the launcher
  icon reads as a different app on the same phone.

  v1 shipped the stopwatch's timer glyph, because the whole app was forked from it and the icon
  came along without anybody looking at the launcher. It said clock, and this is a recorder.

  MANTRA_MANIFEST/modules/app-icon.md: the launcher hands out a 108 canvas and shows the centre
  72. The symbol goes in a 42 box centred in that, which puts the drawn edge at 0.583 of the
  visible circle, inside the 0.55 to 0.60 band measured from icons drawn by people who measured.

  The arithmetic, so nobody has to rediscover it:
    the box is 42 by 42, centred on 54, 54
    so it runs 33..75 on both axes
    the outline is 3 wide, drawn as a stroke on the centreline at 34.5..73.5
    the bars sit inside a 30 wide field from 39 to 69, eleven bars of 2 with 0.8 between

  ELEVEN BARS, NOT A SINE WAVE. A drawn wave is a picture of sound in general; bars of differing
  height are a picture of THIS recording, which is what the tiles show and what the app is for.
  The heights are asymmetric on purpose: a symmetrical set reads as a graphic, an uneven one reads
  as a measurement.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The square. Stroked rather than filled, so the waveform inside is the ink that reads. -->
    <path
        android:pathData="M34.5,34.5 L73.5,34.5 L73.5,73.5 L34.5,73.5 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />

    <!-- Eleven bars, centred on y=54, heights 8..26. -->
    <path android:fillColor="#FFFFFF" android:pathData="M39.0,49.0h2v10h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M41.8,45.0h2v18h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M44.6,41.0h2v26h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M47.4,47.0h2v14h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M50.2,43.0h2v22h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M53.0,50.0h2v8h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M55.8,42.0h2v24h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M58.6,46.0h2v16h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M61.4,44.0h2v20h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M64.2,48.0h2v12h-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M67.0,50.0h2v8h-2z" />
</vector>
